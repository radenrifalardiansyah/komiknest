# Copy to .env.local for development. Everything is optional:
# without Supabase the site runs from content/comics/*.json ("local mode").

# Public site URL (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Supabase (read-only anon key; RLS allows SELECT on published rows only)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared secret for POST /api/revalidate (called by the ingest workflow)
REVALIDATE_SECRET=

# Google AdSense — leave empty until your site is approved
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_COMIC=
NEXT_PUBLIC_ADSENSE_SLOT_READER=
