{
  "name": "komiknest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/build-catalog.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/build-catalog.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "samples": "tsx scripts/generate-samples.ts",
    "catalog": "tsx scripts/build-catalog.ts",
    "ingest": "tsx scripts/ingest/index.ts",
    "cf:build": "tsx scripts/build-catalog.ts && opennextjs-cloudflare build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22"
  }
}
